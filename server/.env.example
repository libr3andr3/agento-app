# agente server configuration — copy to .env and fill in.
DATABASE_URL=sqlite://agente.db
BIND_ADDR=0.0.0.0:8118

# OpenAI-compatible LLM endpoint (DeepSeek by default)
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=CHANGE_ME
LLM_MODEL=deepseek-chat

# Whisper STT (voice onboarding)
OPENAI_API_KEY=CHANGE_ME

# Catalog-photo extraction (DeepSeek key). /api/catalog_photo mounts only
# when the key is set and answers 503 otherwise.
# VISION_API_KEY=
# VISION_MODEL=deepseek-v4-flash-vision-exp
# VISION_BASE_URL=https://api.deepseek.com/v1
# Text-to-speech. Provider chain: fish → elevenlabs → openai → piper (first
# with a key wins; TTS_PROVIDER forces the head). Fish Audio s2-pro: 80
# languages, ~$15/1M bytes (s2.1-pro-free = free, fair use), voice id
# REQUIRED. ElevenLabs Flash v2.5: 32 languages, ~$0.05/1k chars. OpenAI
# gpt-4o-mini-tts: 50+ languages, ~$0.015/min, reuses OPENAI_API_KEY above.
# Piper: offline CPU, es/en only.
# TTS_PROVIDER=fish
# FISH_API_KEY=
# FISH_VOICE=                               # reference_id from fish.audio library (or FISH_VOICE_<LANG>)
# FISH_MODEL=s2-pro                         # or s2.1-pro-free
# ELEVENLABS_API_KEY=
# ELEVEN_VOICE=EXAVITQu4vr4xnSDxMaL        # default multilingual voice id
# ELEVEN_VOICE_ES= ELEVEN_VOICE_HI= ...    # per-language overrides
# OPENAI_VOICE=coral                        # or OPENAI_VOICE_<LANG>
# Piper TTS voices directory (es_ES + en_US onnx models), offline fallback
PIPER_DIR=/opt/agente/tts

# Auth. Both are REQUIRED — the server refuses to boot without them, refuses
# anything under 32 characters, and refuses obvious placeholders. Generate with:
#   openssl rand -base64 48 | tr -dc 'a-zA-Z0-9' | head -c 48
#
# ADMIN_KEY authorizes ONLY /api/curator/* and /api/kernel. It is not a
# substitute for APP_KEY and must never be shipped inside the app.
# APP_KEY is compiled into the APK, so treat it as anti-noise rather than
# authentication — the per-device bearer token is the real credential.
ADMIN_KEY=CHANGE_ME
APP_KEY=CHANGE_ME

# Throttles. Registration is limited in memory, per IP and per owner phone;
# the per-IP limit reads X-Forwarded-For, which is only trustworthy if nothing
# but the TLS terminator can reach BIND_ADDR. Firewall that port.
# REGISTER_PER_IP_PER_HOUR=5
# REGISTER_PER_PHONE_PER_DAY=3

# Per-business daily spend ceilings (Lima days), counted in the database.
# MAX_LLM_CALLS_PER_DAY=2000
# MAX_STT_CALLS_PER_DAY=300
# MAX_TTS_CALLS_PER_DAY=2000
# MAX_VISION_CALLS_PER_DAY=50

# Schema layers (core.yml + vertical bundles)
SCHEMAS_DIR=./schemas

# Email calendar invites — reminders plugin mounts only when configured.
# SMTP_URL=smtps://user:pass@mail.example.com:465
# MAIL_FROM="agente <citas@example.com>"
# Dev alternative: write .eml files instead of sending
# OUTBOX_DIR=./outbox

# Composition by config: skip plugins at boot, e.g. DISABLED_PLUGINS=payments
# DISABLED_PLUGINS=

# WhatsApp OTP via the wa-otp bridge (../wa-otp, a paired linked-device
# session over the Web protocol). Phone verification mounts only when the URL
# is set. WA_BRIDGE_KEY must equal the bridge's WA_OTP_KEY (32+ random chars).
# WA_BRIDGE_URL=http://127.0.0.1:8123
# WA_BRIDGE_KEY=
# Demand a verified phone on /api/onboard_business (refuses to boot if the
# bridge is unconfigured). Off by default until the APK ships the flow.
# REQUIRE_PHONE_VERIFICATION=1

# Free-trial window granted to new businesses (days). After it closes the
# customer agent stops answering; the owner dashboard keeps working.
# TRIAL_DAYS=7
# "Talk to sales" WhatsApp number (E.164). Unset = the first business ever
# registered — the founding user is the sales agent.
# SALES_PHONE=
# OTP_PER_IP_PER_HOUR=10
# OTP_PER_PHONE_PER_DAY=5

# ---- on-device / network (sovereign) ----
# Seals the agent identity seed at rest (32 bytes hex). The Android shell
# supplies one from the Keystore; the host binary may leave it empty.
IDENTITY_KEK_HEX=
# Where the registry / relay / gateway lives.
REGISTRY_URL=https://llm.yaya.tech
# Speech (Whisper + TTS) and catalog vision: with a key, straight to the
# provider; without, through the gateway as this agent. AUDIO=0 / VISION=0 disable.
OPENAI_API_KEY=
VISION_API_KEY=
AUDIO=
VISION=
# Budget for messages arriving from other agents over the relay (free tier;
# paid tiers get 10x). Separate from the customer caps so a flood of fresh
# keys never blocks real customers.
NETWORK_MSGS_PER_DAY=40
NETWORK_CUSTOMERS_PER_DAY=10
# Set to 0 to never listen for relay messages.
NETWORK_INBOX=1
