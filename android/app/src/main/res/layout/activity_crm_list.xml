<?xml version="1.0" encoding="utf-8"?>
<!-- Shared by Conversaciones and Clientes: title, optional search, list. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agente_surface"
    android:orientation="vertical">

    <TextView
        android:id="@+id/crm_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingStart="@dimen/space_l"
        android:paddingTop="@dimen/space_l"
        android:paddingEnd="@dimen/space_l"
        android:textAppearance="?attr/textAppearanceHeadlineSmall"
        android:textColor="@color/agente_on_surface" />

    <!-- D17: the list is the owner's — take it as a file. Contacts mode only. -->
    <TextView
        android:id="@+id/crm_export"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/touch_min"
        android:layout_marginStart="@dimen/space_m"
        android:background="?android:attr/selectableItemBackgroundBorderless"
        android:gravity="center"
        android:paddingStart="@dimen/space_s"
        android:paddingEnd="@dimen/space_s"
        android:text="@string/crm_export"
        android:textAppearance="?attr/textAppearanceLabelLarge"
        android:textColor="@color/agente_primary"
        android:visibility="gone" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/crm_search_til"
        style="@style/Widget.Agente.TextInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_l"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginEnd="@dimen/space_l"
        android:visibility="gone">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/crm_search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="@string/crm_contacts_search"
            android:imeOptions="actionSearch"
            android:inputType="text" />
    </com.google.android.material.textfield.TextInputLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/crm_swipe"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/crm_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/space_m"
                android:paddingTop="@dimen/space_s"
                android:paddingEnd="@dimen/space_m"
                android:paddingBottom="@dimen/space_xl" />
        </ScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
</LinearLayout>
