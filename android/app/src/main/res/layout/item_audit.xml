<?xml version="1.0" encoding="utf-8"?>
<!-- One audit entry: seq + time, the kind chip, a one-line summary, anchored or not. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/space_s"
    app:cardBackgroundColor="@color/agente_surface_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="@dimen/card_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_m"
        android:paddingEnd="@dimen/space_m"
        android:paddingTop="@dimen/space_s"
        android:paddingBottom="@dimen/space_s">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/audit_time"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/agente_on_surface_muted" />

            <com.google.android.material.chip.Chip
                android:id="@+id/audit_kind"
                style="@style/Widget.Agente.Chip"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:clickable="false"
                android:focusable="false"
                android:textAppearance="?attr/textAppearanceLabelSmall"
                app:chipMinHeight="24dp"
                app:chipStrokeWidth="0dp"
                app:ensureMinTouchTargetSize="false" />
        </LinearLayout>

        <TextView
            android:id="@+id/audit_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:ellipsize="end"
            android:maxLines="2"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/agente_on_surface" />

        <TextView
            android:id="@+id/audit_anchored"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            android:textColor="@color/agente_on_surface_muted" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
