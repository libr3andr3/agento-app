<?xml version="1.0" encoding="utf-8"?>
<!-- One catalog photo: a square, the product name under it. -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    app:cardBackgroundColor="@color/agente_surface_card"
    app:cardCornerRadius="18dp"
    app:cardElevation="@dimen/card_elevation"
    app:strokeWidth="0dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/catalog_photo_img"
            android:layout_width="match_parent"
            android:layout_height="110dp"
            android:background="@color/agente_surface_variant"
            android:contentDescription="@string/catalog_photo_desc"
            android:scaleType="centerCrop" />

        <TextView
            android:id="@+id/catalog_photo_caption"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:paddingStart="@dimen/space_s"
            android:paddingEnd="@dimen/space_s"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/agente_on_surface" />
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
