<?xml version="1.0" encoding="utf-8"?>
<!-- Searchable country picker (BottomSheetDialog content). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingStart="@dimen/space_m"
    android:paddingEnd="@dimen/space_m"
    android:paddingTop="@dimen/space_m">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/reg_country_title"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/agente_on_surface" />

    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/country_search_til"
        style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:hintEnabled="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:hint="@string/reg_country_search_hint"
        app:boxCornerRadiusTopStart="@dimen/corner_control"
        app:boxCornerRadiusTopEnd="@dimen/corner_control"
        app:boxCornerRadiusBottomStart="@dimen/corner_control"
        app:boxCornerRadiusBottomEnd="@dimen/corner_control">

        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/country_search_input"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:inputType="text"
            android:imeOptions="actionSearch"
            android:maxLength="40" />
    </com.google.android.material.textfield.TextInputLayout>

    <TextView
        android:id="@+id/country_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_l"
        android:gravity="center"
        android:text="@string/reg_country_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/agente_on_surface_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/country_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="@dimen/space_s"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/space_l" />
</LinearLayout>
