<?xml version="1.0" encoding="utf-8"?>
<!-- Step 1 of 2 at the end of onboarding, and Settings → Apps conectadas:
     which apps the agent may read notifications from, one switch per app
     (ReadAppsActivity). Step 2 is activity_reply_apps. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agente_surface"
    android:focusable="true"
    android:focusableInTouchMode="true"
    android:orientation="vertical">
    <!-- Focusable root: the search field must not take focus (and the
         keyboard) the moment the screen opens. -->

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingHorizontal="@dimen/space_m"
        android:paddingTop="@dimen/space_m">

        <TextView
            android:id="@+id/read_step"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/read_step"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/agente_primary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/read_headline"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/agente_on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_xs"
            android:text="@string/read_sub"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/agente_on_surface_muted" />

        <com.google.android.material.textfield.TextInputLayout
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox.Dense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:hint="@string/read_search_hint"
            app:boxCornerRadiusBottomEnd="@dimen/corner_control"
            app:boxCornerRadiusBottomStart="@dimen/corner_control"
            app:boxCornerRadiusTopEnd="@dimen/corner_control"
            app:boxCornerRadiusTopStart="@dimen/corner_control"
            app:endIconMode="clear_text"
            app:startIconDrawable="@drawable/ic_search"
            app:startIconTint="@color/agente_on_surface_muted">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/read_search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:imeOptions="actionSearch"
                android:inputType="text" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/read_count"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textAppearance="?attr/textAppearanceLabelMedium"
                android:textColor="@color/agente_on_surface_muted" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/read_all"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:minHeight="@dimen/touch_min"
                android:text="@string/read_all_on" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/read_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:paddingHorizontal="@dimen/space_m"
            android:paddingBottom="@dimen/space_m" />

        <com.google.android.material.progressindicator.CircularProgressIndicator
            android:id="@+id/read_loading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:indeterminate="true" />
    </FrameLayout>

    <com.google.android.material.button.MaterialButton
        android:id="@+id/read_cta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/space_m"
        android:enabled="false"
        android:minHeight="@dimen/cta_height"
        android:text="@string/read_next" />
</LinearLayout>
