<?xml version="1.0" encoding="utf-8"?>
<!-- Cobros: where customers send money. Wallet name + destination, typed by
     the owner in their own words; suggestions come from the network. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/agente_surface"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/space_l">

        <TextView
            android:id="@+id/payout_step"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelMedium"
            android:textColor="@color/agente_primary"
            android:visibility="gone" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/payout_headline"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="@color/agente_on_surface" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:text="@string/payout_sub"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/agente_on_surface_muted" />

        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            app:cardBackgroundColor="@color/agente_secondary_container"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_m"
                android:text="@string/payout_notice"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/agente_on_surface" />
        </com.google.android.material.card.MaterialCardView>

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/payout_holder_til"
            style="@style/Widget.Material3.TextInputLayout.OutlinedBox"
            app:hintEnabled="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_l"
            android:hint="@string/payout_holder_hint"
            app:boxCornerRadiusBottomEnd="@dimen/corner_control"
            app:boxCornerRadiusBottomStart="@dimen/corner_control"
            app:boxCornerRadiusTopEnd="@dimen/corner_control"
            app:boxCornerRadiusTopStart="@dimen/corner_control">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/payout_holder"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:inputType="textPersonName|textCapWords" />
        </com.google.android.material.textfield.TextInputLayout>

        <LinearLayout
            android:id="@+id/payout_rows"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/payout_add"
            style="@style/Widget.Agente.Button.Text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/payout_add" />

        <com.google.android.material.materialswitch.MaterialSwitch
            android:id="@+id/payout_cash_only"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:minHeight="@dimen/touch_min"
            android:text="@string/payout_cash_only" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/payout_warning"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_m"
            android:visibility="gone"
            app:cardBackgroundColor="@color/agente_error_container"
            app:cardCornerRadius="@dimen/corner_card"
            app:cardElevation="0dp"
            app:strokeWidth="0dp">

            <TextView
                android:id="@+id/payout_warning_text"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/space_m"
                android:textAppearance="?attr/textAppearanceBodyMedium"
                android:textColor="@color/agente_on_surface" />
        </com.google.android.material.card.MaterialCardView>

        <TextView
            android:id="@+id/payout_error"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            android:textColor="@color/agente_error"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/payout_save"
            android:layout_width="match_parent"
            android:layout_height="@dimen/cta_height"
            android:layout_marginTop="@dimen/space_l"
            android:text="@string/payout_save" />

        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/payout_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/space_s"
            android:indeterminate="true"
            android:visibility="invisible" />
    </LinearLayout>
</ScrollView>
