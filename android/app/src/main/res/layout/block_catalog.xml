<?xml version="1.0" encoding="utf-8"?>
<!-- Block `catalog` (D15): photos of the products in a grid, the two actions
     (add a photo, share a private link), then every product with its price —
     a dim camera means it has no photo yet. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:orientation="horizontal">

        <com.google.android.material.button.MaterialButton
            android:id="@+id/catalog_add"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_min"
            android:text="@string/catalog_add_photo" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/catalog_share"
            style="@style/Widget.Agente.Button.Tonal"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_s"
            android:layout_weight="1"
            android:minHeight="@dimen/touch_min"
            android:text="@string/catalog_share" />
    </LinearLayout>

    <TextView
        android:id="@+id/catalog_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:paddingTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:text="@string/catalog_empty"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/agente_on_surface_muted"
        android:visibility="gone" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/catalog_grid"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:overScrollMode="never" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/space_s"
        android:layout_marginTop="@dimen/space_m"
        android:paddingBottom="@dimen/space_s"
        android:text="@string/catalog_products_header"
        android:textAppearance="?attr/textAppearanceTitleMedium"
        android:textColor="@color/agente_on_surface" />

    <LinearLayout
        android:id="@+id/catalog_products"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical" />
</LinearLayout>
