<?xml version="1.0" encoding="utf-8"?>
<!-- Top-up sheet: presets, method buttons (card everywhere, Yape in Perú), the closed-loop terms. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/space_m">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/credits_topup"
        android:textAppearance="?attr/textAppearanceTitleLarge"
        android:textColor="@color/agente_on_surface" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:text="@string/credits_topup_sub"
        android:textAppearance="?attr/textAppearanceBodyMedium"
        android:textColor="@color/agente_on_surface_muted" />

    <com.google.android.material.button.MaterialButtonToggleGroup
        android:id="@+id/topup_presets"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        app:selectionRequired="true"
        app:singleSelection="true" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/topup_card"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:minHeight="@dimen/cta_height"
        android:text="@string/credits_topup_card" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/topup_yape"
        style="@style/Widget.Material3.Button.OutlinedButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_s"
        android:minHeight="@dimen/cta_height"
        android:text="@string/credits_topup_yape"
        android:visibility="gone"
        app:strokeColor="@color/agente_outline" />

    <TextView
        android:id="@+id/topup_terms"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_m"
        android:layout_marginBottom="@dimen/space_s"
        android:textAppearance="?attr/textAppearanceBodySmall"
        android:textColor="@color/agente_on_surface_muted" />
</LinearLayout>
