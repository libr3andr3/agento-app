<?xml version="1.0" encoding="utf-8"?>
<!-- agente theme v2 "warm paper" — light-committed, custom-typed, pill-shaped.
     Owned by the integrator (DESIGN.md). Layouts should lean on ?attr/ text
     appearances and the Widget.Agente.* styles below, never stock M3 widgets. -->
<!-- tools:targetApi: windowLightNavigationBar (27) and textFontWeight (28) are
     silently ignored below their API level; minSdk stays 26. -->
<resources xmlns:tools="http://schemas.android.com/tools" tools:targetApi="28">

    <style name="Theme.Agente" parent="Theme.Material3.Light.NoActionBar">
        <!-- Color roles -->
        <item name="colorPrimary">@color/agente_primary</item>
        <item name="colorOnPrimary">@color/agente_on_primary</item>
        <item name="colorPrimaryContainer">@color/agente_primary_container</item>
        <item name="colorOnPrimaryContainer">@color/agente_on_primary_container</item>
        <item name="colorSecondary">@color/agente_secondary</item>
        <item name="colorSecondaryContainer">@color/agente_secondary_container</item>
        <item name="colorOnSecondaryContainer">@color/agente_on_secondary_container</item>
        <item name="colorError">@color/agente_error</item>
        <item name="colorErrorContainer">@color/agente_error_container</item>
        <item name="android:colorBackground">@color/agente_surface</item>
        <item name="colorSurface">@color/agente_surface_card</item>
        <item name="colorSurfaceVariant">@color/agente_surface_variant</item>
        <item name="colorOnSurface">@color/agente_on_surface</item>
        <item name="colorOnSurfaceVariant">@color/agente_on_surface_muted</item>
        <item name="colorOutline">@color/agente_outline</item>

        <!-- Keep elevated cards crisp white: no M3 tonal-elevation green wash -->
        <item name="elevationOverlayEnabled">false</item>

        <!-- System bars blend into the paper ground -->
        <item name="android:statusBarColor">@color/agente_surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/agente_surface</item>
        <item name="android:windowLightNavigationBar">true</item>

        <!-- Typeface: Plus Jakarta Sans everywhere -->
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="fontFamily">@font/jakarta</item>
        <item name="textAppearanceDisplaySmall">@style/TextAppearance.Agente.Display</item>
        <item name="textAppearanceHeadlineMedium">@style/TextAppearance.Agente.HeadlineMedium</item>
        <item name="textAppearanceHeadlineSmall">@style/TextAppearance.Agente.Headline</item>
        <item name="textAppearanceTitleLarge">@style/TextAppearance.Agente.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.Agente.Title</item>
        <item name="textAppearanceBodyLarge">@style/TextAppearance.Agente.BodyLarge</item>
        <item name="textAppearanceBodyMedium">@style/TextAppearance.Agente.Body</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.Agente.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.Agente.Label</item>

        <!-- Shape system -->
        <item name="shapeAppearanceCornerSmall">@style/Shape.Agente.Small</item>
        <item name="shapeAppearanceCornerMedium">@style/Shape.Agente.Medium</item>
        <item name="shapeAppearanceCornerLarge">@style/Shape.Agente.Large</item>

        <!-- Widgets default to the Agente styles -->
        <item name="materialButtonStyle">@style/Widget.Agente.Button</item>
        <item name="borderlessButtonStyle">@style/Widget.Agente.Button.Text</item>
        <item name="materialCardViewStyle">@style/Widget.Agente.Card</item>
        <item name="chipStyle">@style/Widget.Agente.Chip</item>
        <item name="textInputStyle">@style/Widget.Agente.TextInput</item>
    </style>

    <!-- ============ Type ramp (Plus Jakarta Sans) ============ -->
    <style name="TextAppearance.Agente.Display" parent="TextAppearance.Material3.DisplaySmall">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Agente.HeadlineMedium" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:letterSpacing">-0.02</item>
    </style>

    <style name="TextAppearance.Agente.Headline" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Agente.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textFontWeight">700</item>
        <item name="android:letterSpacing">-0.01</item>
    </style>

    <style name="TextAppearance.Agente.Title" parent="TextAppearance.Material3.TitleMedium">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Agente.BodyLarge" parent="TextAppearance.Material3.BodyLarge">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Agente.Body" parent="TextAppearance.Material3.BodyMedium">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Agente.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="TextAppearance.Agente.Label" parent="TextAppearance.Material3.LabelMedium">
        <item name="fontFamily">@font/jakarta</item>
        <item name="android:fontFamily">@font/jakarta</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:letterSpacing">0.01</item>
    </style>

    <!-- ============ Shapes ============ -->
    <style name="Shape.Agente.Small" parent="ShapeAppearance.Material3.Corner.Small">
        <item name="cornerSize">12dp</item>
    </style>
    <style name="Shape.Agente.Medium" parent="ShapeAppearance.Material3.Corner.Medium">
        <item name="cornerSize">18dp</item>
    </style>
    <style name="Shape.Agente.Large" parent="ShapeAppearance.Material3.Corner.Large">
        <item name="cornerSize">@dimen/corner_card</item>
    </style>
    <style name="Shape.Agente.Pill" parent="ShapeAppearance.Material3.Corner.Full" />

    <!-- ============ Widgets ============ -->
    <!-- Primary action: emerald pill, generous height -->
    <style name="Widget.Agente.Button" parent="Widget.Material3.Button">
        <item name="shapeAppearance">@style/Shape.Agente.Pill</item>
        <item name="android:minHeight">@dimen/touch_min</item>
        <item name="android:textAppearance">@style/TextAppearance.Agente.LabelLarge</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/agente_primary</item>
        <item name="android:textColor">@color/agente_on_primary</item>
    </style>

    <!-- Quiet action: emerald text, no fill -->
    <style name="Widget.Agente.Button.Text" parent="Widget.Material3.Button.TextButton">
        <item name="shapeAppearance">@style/Shape.Agente.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Agente.LabelLarge</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:textColor">@color/agente_primary</item>
    </style>

    <!-- Soft action: mint pill -->
    <style name="Widget.Agente.Button.Tonal" parent="Widget.Material3.Button.TonalButton">
        <item name="shapeAppearance">@style/Shape.Agente.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Agente.LabelLarge</item>
        <item name="android:letterSpacing">0</item>
        <item name="backgroundTint">@color/agente_primary_container</item>
        <item name="android:textColor">@color/agente_on_primary_container</item>
    </style>

    <!-- Square glyph button for composer rows (48dp, no fill) -->

    <!-- Floating card: strokeless white, whisper of shadow -->
    <style name="Widget.Agente.Card" parent="Widget.Material3.CardView.Elevated">
        <item name="cardBackgroundColor">@color/agente_surface_card</item>
        <item name="cardCornerRadius">@dimen/corner_card</item>
        <item name="cardElevation">@dimen/card_elevation</item>
        <item name="strokeWidth">0dp</item>
        <item name="android:outlineAmbientShadowColor" tools:targetApi="p">@color/agente_shadow</item>
        <item name="android:outlineSpotShadowColor" tools:targetApi="p">@color/agente_shadow</item>
    </style>

    <!-- Status pill -->
    <style name="Widget.Agente.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="chipStrokeWidth">0dp</item>
        <item name="shapeAppearance">@style/Shape.Agente.Pill</item>
        <item name="android:textAppearance">@style/TextAppearance.Agente.LabelLarge</item>
        <item name="chipMinHeight">34dp</item>
        <item name="ensureMinTouchTargetSize">false</item>
    </style>

    <!-- Input: soft white pill-ish field, no floating label -->
    <style name="Widget.Agente.TextInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxBackgroundColor">@color/agente_input_bg</item>
        <item name="boxStrokeColor">@color/agente_input_stroke</item>
        <item name="boxStrokeWidth">1dp</item>
        <item name="boxStrokeWidthFocused">2dp</item>
        <item name="boxCornerRadiusTopStart">18dp</item>
        <item name="boxCornerRadiusTopEnd">18dp</item>
        <item name="boxCornerRadiusBottomStart">18dp</item>
        <item name="boxCornerRadiusBottomEnd">18dp</item>
    </style>
</resources>
