# yaya-gateway — copy to .env (mode 600). Everything is read at boot.
BIND_ADDR=127.0.0.1:8120
DATABASE_URL=sqlite://gateway.db
PUBLIC_URL=https://llm.yaya.tech
RUST_LOG=info

# Ops key: /admin/plan. 32+ random characters.
ADMIN_KEY=
# Registry signing key (32 bytes hex). Absent = minted into the DB on first boot.
REGISTRY_SEED=

# Upstream LLM (OpenAI-compatible). The gateway pins the model.
UPSTREAM_URL=https://api.deepseek.com/v1/chat/completions
UPSTREAM_KEY=
UPSTREAM_MODEL=deepseek-chat
MAX_TOKENS_CAP=2048
# Media proxies: absent key = endpoint answers 503.
OPENAI_API_KEY=
VISION_API_KEY=
VISION_BASE_URL=https://api.deepseek.com/v1
VISION_MODEL=deepseek-v4-flash-vision-exp

# Budgets (per UTC day).
FREE_CALLS_PER_DAY=600
FREE_MEDIA_PER_DAY=150
NEW_AGENTS_PER_IP_PER_DAY=20
CALLS_PER_IP_PER_DAY=5000
RELAY_PAIR_PER_DAY=40

# Request signatures (yaya-wire reqsig v1) are required. During a rollout,
# accept unsigned bearers until this RFC3339 instant so previous app builds
# keep working; leave empty to enforce immediately.
AUTH_GRACE_UNTIL=
AUTH_WINDOW_SECS=300

# Android key attestation policy: which apps count as ours.
EXPECTED_PACKAGE=yaya.tech.agente,yaya.tech.agente.business
# SHA-256 of the signing certificates (apksigner verify --print-certs), comma-separated.
EXPECTED_SIGNERS=

# Business plans through yaya.cash (dashboard session auth). Absent = manual confirmation only.
YAYACASH_URL=https://yaya.cash
YAYACASH_USER=
YAYACASH_PASSWORD=
PLAN_CURRENCY=PEN
PAY_YAPE_NUMBER=
PAY_PLIN_NUMBER=
PAY_PAYEE_NAME=
SALES_PHONE=
# Consumer plans through Google Play.
PLAY_SERVICE_ACCOUNT_FILE=

# Yaya ID + backups.
ACCOUNTS_PER_IP_PER_HOUR=5
LOGINS_PER_IP_PER_HOUR=30
LOGINS_PER_EMAIL_PER_HOUR=10
# Where encrypted snapshots live (one directory per account); newest N kept.
BACKUP_DIR=backups
BACKUP_KEEP=5
# 1 = backups on the free tier too (development).
BACKUPS_FREE=

# Network credits (minor units). Paid plans grant 50% of their price.
NETWORK_LEAD_PRICE_MINOR=500
FREE_STARTER_CREDITS_MINOR=1000
# Monthly prices, whole soles.
PLAN_PRO_PRICE=100
PLAN_MAX_PRICE=500
PLAN_ENTERPRISE_PRICE=1000

# One-time codes (Yaya ID has no passwords): WhatsApp through the wa-otp
# bridge and/or email through SMTP. At least one must be configured.
WA_BRIDGE_URL=http://127.0.0.1:8123
WA_BRIDGE_KEY=
# Proton Mail SMTP submission: username = the address (URL-encoded @), password = an SMTP token.
SMTP_URL=smtp://agente%40yaya.tech:SMTP_TOKEN@smtp.protonmail.ch:587?tls=required
MAIL_FROM="Yaya <agente@yaya.tech>"
OTP_PER_IP_PER_HOUR=20
OTP_PER_TARGET_PER_HOUR=5

# Guests without an account may share redacted conversations for training.
TRAINING_PER_AGENT_PER_DAY=500

# ---- Agent0 console, trial and recargas (gateway 0.3) ----
# Every new account gets Pro for TRIAL_DAYS, then answers only with a plan or credits.
TRIAL_DAYS=7
# Credits: one gateway call costs CREDIT_CALL_PRICE_MINOR céntimos when past the
# plan cap or without a plan; the screens assume CREDIT_CALLS_PER_MESSAGE calls
# per customer message (S/ 0.05 × 2 = S/ 0.10 per message).
CREDIT_CALL_PRICE_MINOR=5
CREDIT_CALLS_PER_MESSAGE=2
# Recarga sizes offered, minor units (S/ 20 · 50 · 100).
RECARGA_OPTIONS_MINOR=2000,5000,10000
# Relay messages per day between two devices of the SAME account (the web
# console talking to its phone) — far above the stranger cap RELAY_PAIR_PER_DAY.
RELAY_OWN_PAIR_PER_DAY=3000
